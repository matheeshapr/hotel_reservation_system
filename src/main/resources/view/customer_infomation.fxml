<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="749.0" prefWidth="947.0" style="-fx-background-color: #e6ffff;" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controller.CustomerInfomation">

    <children>

        <!-- Room Table Card -->
        <Pane layoutX="76.0" layoutY="98.0" prefHeight="323.0" prefWidth="805.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 10, 0, 0, 5);">
            <children>
                <Label layoutX="30.0" layoutY="20.0" textFill="#003049">
                    <font>
                        <Font name="Segoe UI Bold" size="18.0" />
                    </font>
                </Label>

                <TableView fx:id="tblcustinfo" layoutX="18.0" layoutY="14.0" prefHeight="290.0" prefWidth="770.0" style="-fx-background-color: white; -fx-border-color: #adb5bd; -fx-border-radius: 10;">
                    <columns>
                        <TableColumn fx:id="colId" prefWidth="100.0" text="ID" />
                        <TableColumn fx:id="colName" prefWidth="197.0" text="Name" />
                        <TableColumn fx:id="colPhno" prefWidth="163.0" text="Phone Number" />
                        <TableColumn fx:id="colCity" prefWidth="137.0" text="City" />
                        <TableColumn fx:id="colAddress" prefWidth="171.0" text="Address" />
                    </columns>
                </TableView>
            </children>
        </Pane>

        <Button layoutX="328.0" layoutY="673.0" mnemonicParsing="false" onAction="#updatecustAction" prefHeight="35.0" prefWidth="120.0" style="-fx-background-color: #06d6a0; -fx-text-fill: white; -fx-background-radius: 20;" text="UPDATE">
            <font>
                <Font name="Berlin Sans FB Bold" size="12.0" />
            </font>
        </Button>
        <Button layoutX="154.0" layoutY="673.0" mnemonicParsing="false" onAction="#addcustAction" prefHeight="35.0" prefWidth="120.0" style="-fx-background-color: #06d6a0; -fx-text-fill: white; -fx-background-radius: 20;" text="ADD">
            <font>
                <Font name="Berlin Sans FB Bold" size="12.0" />
            </font>
        </Button>
        <Button layoutX="497.0" layoutY="673.0" mnemonicParsing="false" onAction="#deletecustAction" prefHeight="35.0" prefWidth="120.0" style="-fx-background-color: #06d6a0; -fx-text-fill: white; -fx-background-radius: 20;" text="DELETE">
            <font>
                <Font name="Berlin Sans FB Bold" size="12.0" />
            </font>
        </Button>
        <Button layoutX="684.0" layoutY="673.0" mnemonicParsing="false" onAction="#clearcustAction" prefHeight="35.0" prefWidth="120.0" style="-fx-background-color: #06d6a0; -fx-text-fill: white; -fx-background-radius: 20;" text="CLEAR">
            <font>
                <Font name="Berlin Sans FB Bold" size="12.0" />
            </font>
        </Button>
        <TextField fx:id="txtId" layoutX="127.0" layoutY="456.0" prefHeight="35.0" prefWidth="298.0" promptText="ID" />
        <TextField fx:id="txtName" layoutX="518.0" layoutY="456.0" prefHeight="35.0" prefWidth="298.0" promptText="Name" />
        <TextField fx:id="txtPhno" layoutX="124.0" layoutY="529.0" prefHeight="35.0" prefWidth="298.0" promptText="Phone Number" />
        <TextField fx:id="txtCity" layoutX="518.0" layoutY="529.0" prefHeight="35.0" prefWidth="298.0" promptText="City" />
        <TextField fx:id="txtAddress" layoutX="330.0" layoutY="591.0" prefHeight="35.0" prefWidth="298.0" promptText="Address" />
      <Pane prefHeight="60.0" prefWidth="954.0" style="-fx-background-color: linear-gradient(to bottom right, #0f2027, #203a43, #2c5364); -fx-background-radius: 0 0 15 15;">
         <children>
            <Label layoutX="20.0" layoutY="15.0" style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;" text="🏨 LUXE HOTEL CUSTOMER" />
            <HBox layoutX="600.0" layoutY="10.0" spacing="15">
               <children>
                  <Button onAction="#custaction" style="-fx-background-color: rgba(255,255,255,0.15); -fx-background-color: #ff006e; -fx-text-fill: white; -fx-background-radius: 25; -fx-padding: 8 20; -fx-font-weight: bold;" text="Customers" />
                  <Button onAction="#roomaction" style="-fx-background-color: rgba(255,255,255,0.15);                                        -fx-text-fill: white; -fx-background-radius: 25;                                        -fx-padding: 8 20; -fx-font-weight: bold;" text="Rooms" />
                  <Button onAction="#staffaction" style="-fx-text-fill: white; -fx-background-color: rgba(255,255,255,0.15); -fx-background-radius: 25; -fx-padding: 8 20; -fx-font-weight: bold;" text="Staff" />
               </children>
            </HBox>
            <Circle fill="#06d6a0" layoutX="900.0" layoutY="30.0" radius="18" stroke="white" strokeWidth="2" />
            <Button layoutX="485.0" layoutY="10.0" onAction="#dashaction" style="-fx-background-color: rgba(255,255,255,0.15); -fx-text-fill: white; -fx-background-radius: 25; -fx-padding: 8 20; -fx-font-weight: bold;" text="Dashboard" />
         </children>
      </Pane>

    </children>
</AnchorPane>
