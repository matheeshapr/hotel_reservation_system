<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="550.0" prefWidth="950.0" xmlns="http://javafx.com/javafx/24.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Controller.DashboardController"
            style="-fx-background-color: linear-gradient(to bottom, #f8f9fa, #e9ecef);">

    <children>

        <Pane prefHeight="55.0" prefWidth="950.0" style="-fx-background-color: #212529;">
            <children>
                <Label layoutX="20.0" layoutY="15.0" text="🏨 Hotel Dashboard"
                       style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;"/>
                <HBox layoutX="650.0" layoutY="10.0" spacing="15">
                    <children>
                        <Button text="CUSTOMER" onAction="#custaction"
                                style="-fx-background-color: #495057; -fx-text-fill: white;
                                       -fx-background-radius: 8; -fx-font-weight: bold;"/>
                        <Button text="ROOM" onAction="#roomaction"
                                style="-fx-background-color: #495057; -fx-text-fill: white;
                                       -fx-background-radius: 8; -fx-font-weight: bold;"/>
                        <Button onAction="#staffaction"
                                style="-fx-background-color: #495057; -fx-text-fill: white;                                        -fx-background-radius: 8; -fx-font-weight: bold;"
                                text="STAFF"/>
                    </children>
                </HBox>
            </children>
        </Pane>

        <HBox layoutX="40.0" layoutY="80.0" spacing="25">
            <children>
                <Pane prefHeight="100.0" prefWidth="200.0"
                      style="-fx-background-color: #cdb4db; -fx-background-radius: 15; -fx-effect: dropshadow(gaussian, #bbb, 5, 0, 2, 2);">
                    <children>
                        <Label text="Bookings" layoutX="20.0" layoutY="20.0"
                               style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
                        <Label fx:id="lblBookings" text="120" layoutX="20.0" layoutY="55.0"
                               style="-fx-font-size: 22px; -fx-text-fill: #333;"/>
                    </children>
                </Pane>

                <Pane prefHeight="100.0" prefWidth="200.0"
                      style="-fx-background-color: #ff006e; -fx-background-radius: 15; -fx-effect: dropshadow(gaussian, #bbb, 5, 0, 2, 2);">
                    <children>
                        <Label text="Customers" layoutX="20.0" layoutY="20.0"
                               style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                        <Label fx:id="lblCustomers" text="80" layoutX="20.0" layoutY="55.0"
                               style="-fx-font-size: 22px; -fx-text-fill: white;"/>
                    </children>
                </Pane>

                <Pane prefHeight="100.0" prefWidth="200.0"
                      style="-fx-background-color: #06d6a0; -fx-background-radius: 15; -fx-effect: dropshadow(gaussian, #bbb, 5, 0, 2, 2);">
                    <children>
                        <Label text="Available Rooms" layoutX="20.0" layoutY="20.0"
                               style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                        <Label fx:id="lblRooms" text="25" layoutX="20.0" layoutY="55.0"
                               style="-fx-font-size: 22px; -fx-text-fill: white;"/>
                    </children>
                </Pane>

                <Pane prefHeight="100.0" prefWidth="200.0"
                      style="-fx-background-color: #8ecae6; -fx-background-radius: 15; -fx-effect: dropshadow(gaussian, #bbb, 5, 0, 2, 2);">
                    <children>
                        <Label text="Revenue" layoutX="20.0" layoutY="20.0"
                               style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
                        <Label fx:id="lblRevenue" text="23,422 $" layoutX="20.0" layoutY="55.0"
                               style="-fx-font-size: 22px; -fx-text-fill: #333;"/>
                    </children>
                </Pane>
            </children>
        </HBox>

        <Pane layoutX="250.0" layoutY="220.0" prefHeight="300.0" prefWidth="450.0"
              style="-fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(gaussian, #aaa, 10, 0, 4, 4);">
            <children>
                <Label text="Monthly Performance" layoutX="20.0" layoutY="10.0"
                       style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
                <BarChart layoutX="20.0" layoutY="40.0" prefHeight="240.0" prefWidth="410.0"
                          style="-fx-background-color: transparent;">
                    <xAxis>
                        <CategoryAxis side="BOTTOM" label="Month"/>
                    </xAxis>
                    <yAxis>
                        <NumberAxis side="LEFT" label="Revenue"/>
                    </yAxis>
                </BarChart>
            </children>
        </Pane>

        <VBox layoutX="40.0" layoutY="220.0" spacing="20">
            <children>
                <Pane prefHeight="140.0" prefWidth="180.0"
                      style="-fx-background-color: #fff; -fx-background-radius: 15; -fx-effect: dropshadow(gaussian, #aaa, 10, 0, 3, 3);">
                    <children>
                        <Label text="Top Room Type" layoutX="20.0" layoutY="20.0"
                               style="-fx-font-size: 15px; -fx-font-weight: bold;"/>
                        <Label fx:id="lblTopRoom" text="Deluxe Suite" layoutX="20.0" layoutY="60.0"
                               style="-fx-font-size: 18px;"/>
                    </children>
                </Pane>

                <Pane prefHeight="140.0" prefWidth="180.0"
                      style="-fx-background-color: #fff; -fx-background-radius: 15; -fx-effect: dropshadow(gaussian, #aaa, 10, 0, 3, 3);">
                    <children>
                        <Label text="Today's Guests" layoutX="20.0" layoutY="20.0"
                               style="-fx-font-size: 15px; -fx-font-weight: bold;"/>
                        <Label fx:id="lblGuestsToday" text="42" layoutX="20.0" layoutY="60.0"
                               style="-fx-font-size: 18px;"/>
                    </children>
                </Pane>
            </children>
        </VBox>

        <VBox layoutX="730.0" layoutY="220.0" spacing="20">
            <children>
                <Pane prefHeight="140.0" prefWidth="180.0"
                      style="-fx-background-color: #fff; -fx-background-radius: 15; -fx-effect: dropshadow(gaussian, #aaa, 10, 0, 3, 3);">
                    <children>
                        <Label text="Upcoming Check-ins" layoutX="20.0" layoutY="20.0"
                               style="-fx-font-size: 15px; -fx-font-weight: bold;"/>
                        <Label fx:id="lblCheckins" text="15" layoutX="20.0" layoutY="60.0"
                               style="-fx-font-size: 18px;"/>
                    </children>
                </Pane>

                <Pane prefHeight="140.0" prefWidth="180.0"
                      style="-fx-background-color: #fff; -fx-background-radius: 15; -fx-effect: dropshadow(gaussian, #aaa, 10, 0, 3, 3);">
                    <children>
                        <Label text="Check-outs Today" layoutX="20.0" layoutY="20.0"
                               style="-fx-font-size: 15px; -fx-font-weight: bold;"/>
                        <Label fx:id="lblCheckouts" text="9" layoutX="20.0" layoutY="60.0"
                               style="-fx-font-size: 18px;"/>
                    </children>
                </Pane>
            </children>
        </VBox>
    </children>
</AnchorPane>
