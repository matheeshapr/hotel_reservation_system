<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="749.0" prefWidth="957.0" style="-fx-background-color: #e6ffff;" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controller.StaffinfoController">

    <children>

        <!-- Room Table Card -->
        <Pane layoutX="76.0" layoutY="98.0" prefHeight="348.0" prefWidth="805.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 10, 0, 0, 5);">
            <children>

                <TableView fx:id="tblstaffinfo" layoutX="18.0" layoutY="23.0" prefHeight="300.0" prefWidth="770.0" style="-fx-background-color: white; -fx-border-color: #adb5bd; -fx-border-radius: 10;">
                    <columns>
                        <TableColumn fx:id="colid" prefWidth="79.0" text="ID" />
                        <TableColumn fx:id="colname" prefWidth="113.0" text="Name" />
                        <TableColumn fx:id="colrole" prefWidth="148.0" text="Role" />
                        <TableColumn fx:id="colemail" prefWidth="143.0" text="Email" />
                  <TableColumn fx:id="colphno" prefWidth="146.0" text="Phone Number" />
                  <TableColumn fx:id="colsalary" prefWidth="139.0" text="Salary" />
                    </columns>
                </TableView>
            </children>
        </Pane>

        <Button layoutX="328.0" layoutY="673.0" mnemonicParsing="false" onAction="#updateAction" prefHeight="35.0" prefWidth="120.0" style="-fx-background-color: #06d6a0; -fx-text-fill: white; -fx-background-radius: 20;" text="UPDATE">
            <font>
                <Font name="Berlin Sans FB Bold" size="12.0" />
            </font>
        </Button>
        <Pane prefHeight="55.0" prefWidth="957.0" style="-fx-background-color: #212529;">
            <children>
                <Label layoutX="20.0" layoutY="15.0" style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;" text="🛋Staff Infomation" />
                <HBox layoutX="650.0" layoutY="10.0" spacing="15">
                    <children>
                        <Button onAction="#custaction" style="-fx-background-color: #495057; -fx-text-fill: white;                                        -fx-background-radius: 8; -fx-font-weight: bold;" text="CUSTOMER" />
                        <Button onAction="#roomaction" style="-fx-background-color: #495057; -fx-text-fill: white;                                        -fx-background-radius: 8; -fx-font-weight: bold;" text="ROOM" />
                  <Button onAction="#staffaction" style="-fx-background-color: #495057; -fx-text-fill: white;                                        -fx-background-radius: 8; -fx-font-weight: bold;" text="STAFF" />
                    </children>
                </HBox>
            </children>
        </Pane>
        <Button layoutX="154.0" layoutY="673.0" mnemonicParsing="false" onAction="#addAction" prefHeight="35.0" prefWidth="120.0" style="-fx-background-color: #06d6a0; -fx-text-fill: white; -fx-background-radius: 20;" text="ADD">
            <font>
                <Font name="Berlin Sans FB Bold" size="12.0" />
            </font>
        </Button>
        <Button layoutX="497.0" layoutY="673.0" mnemonicParsing="false" onAction="#deleteAction" prefHeight="35.0" prefWidth="120.0" style="-fx-background-color: #06d6a0; -fx-text-fill: white; -fx-background-radius: 20;" text="DELETE">
            <font>
                <Font name="Berlin Sans FB Bold" size="12.0" />
            </font>
        </Button>
        <Button layoutX="684.0" layoutY="673.0" mnemonicParsing="false" onAction="#clearAction" prefHeight="35.0" prefWidth="120.0" style="-fx-background-color: #06d6a0; -fx-text-fill: white; -fx-background-radius: 20;" text="CLEAR">
            <font>
                <Font name="Berlin Sans FB Bold" size="12.0" />
            </font>
        </Button>
        <TextField fx:id="txtRole" layoutX="133.0" layoutY="509.0" prefHeight="35.0" prefWidth="298.0" promptText="Role" />
        <TextField fx:id="txtEmail" layoutX="527.0" layoutY="509.0" prefHeight="35.0" prefWidth="298.0" promptText="Email" />
        <TextField fx:id="txtPhno" layoutX="133.0" layoutY="561.0" prefHeight="35.0" prefWidth="298.0" promptText="Phone Number" />
        <TextField fx:id="txtSalary" layoutX="527.0" layoutY="561.0" prefHeight="35.0" prefWidth="298.0" promptText="Salary" />
      <TextField fx:id="txtId" layoutX="134.0" layoutY="461.0" prefHeight="35.0" prefWidth="298.0" promptText="ID" />
      <TextField fx:id="txtName" layoutX="525.0" layoutY="461.0" prefHeight="35.0" prefWidth="298.0" promptText="Name" />

    </children>
</AnchorPane>
